# naked agent configuration

# Provider API keys
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Default provider and model
DEFAULT_PROVIDER=anthropic
DEFAULT_MODEL=claude-sonnet-4-20250514

# Workspace directory (default: current directory)
# WORKSPACE=/home/user/project

# Agent loop settings
MAX_ITERATIONS=50
TOOL_TIMEOUT_SECS=120
AUTO_APPROVE=false

# System prompt file (default: ~/.naked/system_prompt.md)
# Override per-project: {workspace}/.naked/system_prompt.md
# SYSTEM_PROMPT_PATH=/path/to/custom_prompt.md

# Session storage (default: .naked/sessions relative to workspace)
# SESSION_DIR=.naked/sessions

# MCP configuration (JSON file with mcpServers)
# MCP_CONFIG_PATH=.naked/mcp.json

# Fallback models (comma-separated provider/model)
# FALLBACK_MODELS=anthropic/claude-haiku,openai/gpt-4o

# Skill search roots (colon-separated)
# SKILL_ROOTS=~/.naked/skills:~/.agents/skills

# Telegram (Phase 2)
# TELEGRAM_BOT_TOKEN=...
