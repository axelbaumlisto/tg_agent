  "default_provider": "anthropic",
  "default_model": "claude-sonnet-4-20250514",

  "fallback": [
    "groq/llama-3.3-70b-versatile",
    "deepseek/deepseek-chat",
    "openai/gpt-4o-mini"
  ],

  "max_iterations": 50,
  "tool_timeout_secs": 120,
  "session_dir": ".naked/sessions",
  "skill_roots": ["~/.naked/skills"],

  "_tg_media_doc": "Telegram media handling. Controls how images/audio/video/files attached in TG chats are routed into the conversation.",
  "tg_media": {
    "_native_image_context_doc": "When true, photos and static stickers are attached as native ContentBlock::Image to the chat request (raw base64 to vision-capable models like Claude 3+, GPT-4o, llama-4-scout). When false, every image goes through the legacy describer path (separate vision provider summarises the image into text). Default: true.",
    "native_image_context": true,

    "_native_image_max_bytes_doc": "Hard upper bound on per-image bytes for the native multimodal path. Images above this limit (whether from Telegram metadata pre-check or from the actual download) are downgraded to the describer path to avoid provider 'image too large' errors. Default: 4 MiB (matches Groq's hard cap).",
    "native_image_max_bytes": 4194304,

    "_vision_model_extras_doc": "Substring needles added to the built-in vision-capable model allowlist. Use this to opt-in new vision model IDs (e.g. 'qwen3-vl', 'internlm-xcomposer2.5') without code changes. Each entry is a case-insensitive substring matched against model IDs.",
    "vision_model_extras": [],

    "_vision_doc": "Optional fallback describer (OpenAI-compatible chat-completions with image_url). Used when the active model is NOT vision-capable OR when native_image_context is false. Set api_key to a literal token or '$ENV_VAR'.",
    "vision": {
      "api_url": "https://api.openai.com/v1/chat/completions",
      "api_key": "$OPENAI_API_KEY",
      "model": "gpt-4o-mini",
      "max_tokens": 400,
      "prompt_override": null
    },

    "_audio_doc": "Optional voice / audio transcription endpoint (OpenAI-compatible Whisper). Required for transcripts of TG voice messages and audio files. Recommended: Groq whisper-large-v3 (free tier, fast).",
    "audio": {
      "api_url": "https://api.groq.com/openai/v1/audio/transcriptions",
      "api_key": "$GROQ_API_KEY",
      "model": "whisper-large-v3",
      "language": null
    },

    "_limits_doc": "Hard per-kind byte caps applied AFTER Telegram's 20 MB upload limit. Defaults: photo 5 MB, audio 20 MB, doc 10 MB.",
    "limits": {
      "photo_max_bytes": 5242880,
      "audio_max_bytes": 20971520,
      "doc_max_bytes": 10485760
    },

    "_artifact_retention_days_doc": "Days to keep downloaded TG files in workspace/.naked/artifacts/. 0 disables sweeping. Default: 7.",
    "artifact_retention_days": 7,

    "_docs_inline_max_bytes_doc": "Inline documents up to this size into the prompt; larger ones are saved to disk and only the path is relayed. Default: 128 KiB.",
    "docs_inline_max_bytes": 131072
  },

  "mcpServers": {}
}
