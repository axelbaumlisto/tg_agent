# Required
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# OpenCode server
OC_BASE_URL=http://127.0.0.1:14096
OC_DIRECTORY=/home/user/project

# Access control — comma-separated Telegram chat IDs (empty = allow all)
ALLOWED_CHAT_IDS=

# Runner tuning
OC_TG_IDLE_TIMEOUT=3600
OC_TG_EDIT_INTERVAL=2.0
OC_TG_WATCHDOG_INTERVAL=60

# Telethon (for E2E tests only)
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_OPERATOR_CHAT_ID=0
